# The repository starts in fixture mode and needs no external service.
APP_ENV=local
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DATA_MODE=fixture
# A indexação e os headers de lançamento só abrem quando ambos os gates
# APP_ENV=production e PUBLIC_LAUNCH_ENABLED=true forem deliberados.
PUBLIC_LAUNCH_ENABLED=false

# Evidence identifiers are required by check:release-readiness only when the
# public launch gate is enabled. They are references, never the documents.
LEGAL_DPIA_EVIDENCE_ID=
PENTEST_EVIDENCE_ID=
RLS_MATRIX_EVIDENCE_ID=
BILLING_RECONCILIATION_EVIDENCE_ID=
CLINICAL_REVIEW_EVIDENCE_LOAD_STRUCTURES=
CLINICAL_REVIEW_EVIDENCE_SESSION_INVENTORY=

# Add values only when you deliberately create isolated Supabase projects.
# Never use the Lost Letters Room project or credentials.
NEXT_PUBLIC_SUPABASE_CLINICAL_URL=
NEXT_PUBLIC_SUPABASE_CLINICAL_ANON_KEY=
SUPABASE_CLINICAL_SERVICE_ROLE_KEY=
SUPABASE_PLATFORM_URL=
SUPABASE_PLATFORM_SERVICE_ROLE_KEY=
SUPABASE_PUBLIC_URL=
SUPABASE_PUBLIC_SERVICE_ROLE_KEY=
# Random server-only secret used to pseudonymize the anonymous community cookie.
PUBLIC_EXPERIENCE_HMAC_SECRET=

# Keep disabled until a future commercial phase.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
